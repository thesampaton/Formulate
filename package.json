{
  "name": "formulate",
  "version": "0.0.1",
  "description": "React form composition primitives and scenario examples",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @formulate/examples dev",
    "build": "pnpm registry:build && pnpm --filter @formulate/react build && pnpm --filter @formulate/examples build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "registry:build": "pnpm --filter @formulate/examples registry:build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  }
}
